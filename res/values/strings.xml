    <string name="launcher_learning_heading">Adaptive learning</string>
    <string name="launcher_learning_summary">Nothing becomes a learned word silently. Teach actions ask first; the third use of one unknown pattern in the current editor session asks whether to keep or replace it. Explicit correction rules stay local and editable.</string>
