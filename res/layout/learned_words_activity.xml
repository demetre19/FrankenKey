<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0D10"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="48dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">
    <ImageButton
        android:id="@+id/learned_words_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/reader_icon_button"
        android:contentDescription="@string/reader_back"
        android:padding="0dp"
        android:scaleType="center"
        android:src="@drawable/ic_reader_back"
        android:tint="#F4F7FA"/>
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:text="@string/learned_words_title"
        android:textColor="#F4F7FA"
        android:textSize="20sp"
        android:textStyle="bold"/>
  </LinearLayout>

  <LinearLayout
      android:id="@+id/learned_words_tabs"
      android:layout_width="match_parent"
      android:layout_height="48dp"
      android:layout_marginTop="8dp"
      android:orientation="horizontal"/>

  <FrameLayout
      android:id="@+id/learned_words_tab_content"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"/>
</LinearLayout>
