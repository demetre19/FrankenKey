<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0D10"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="48dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">
    <ImageButton
        android:id="@+id/learned_words_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/reader_icon_button"
        android:contentDescription="@string/reader_back"
        android:padding="0dp"
        android:scaleType="center"
        android:src="@drawable/ic_reader_back"
        android:tint="#F4F7FA"/>
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:text="@string/learned_words_title"
        android:textColor="#F4F7FA"
        android:textSize="20sp"
        android:textStyle="bold"/>
  </LinearLayout>

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="48dp"
      android:layout_marginTop="8dp"
      android:orientation="horizontal">
    <Button
        android:id="@+id/learned_words_taught_tab"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:background="@drawable/reader_icon_button"
        android:text="@string/learned_words_taught_tab"
        android:textAllCaps="false"/>
    <Button
        android:id="@+id/learned_words_corrections_tab"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:background="@drawable/reader_icon_button"
        android:text="@string/learned_words_corrections_tab"
        android:textAllCaps="false"/>
  </LinearLayout>

  <TextView
      android:id="@+id/learned_words_scope_explanation"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:paddingStart="4dp"
      android:paddingEnd="4dp"
      android:text="@string/learned_words_taught_explanation"
      android:textColor="#A8B2BE"
      android:textSize="13sp"/>

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="48dp"
      android:layout_marginTop="8dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">
    <FrameLayout
        android:id="@+id/learned_words_add_container"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:background="@drawable/launcher_input">
      <EditText
          android:id="@+id/learned_words_add"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:background="@null"
          android:layout_marginStart="12dp"
          android:layout_marginEnd="12dp"
          android:gravity="center_vertical"
          android:hint="@string/learned_words_add_hint"
          android:imeOptions="actionDone|flagNoPersonalizedLearning"
          android:importantForAutofill="no"
          android:inputType="text|textNoSuggestions"
          android:maxLines="1"
          android:singleLine="true"
          android:textColor="#F4F7FA"
          android:textColorHint="#A8B2BE"/>
    </FrameLayout>
    <Button
        android:id="@+id/learned_words_primary_action"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/reader_icon_button"
        android:minWidth="80dp"
        android:text="@string/learned_words_add_action"
        android:textColor="#F4F7FA"/>
  </LinearLayout>

  <FrameLayout
      android:id="@+id/learned_words_search_container"
      android:layout_width="match_parent"
      android:layout_height="48dp"
      android:layout_marginTop="8dp"
      android:layout_marginBottom="8dp"
      android:background="@drawable/launcher_input">
    <EditText
        android:id="@+id/learned_words_search"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@null"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:gravity="center_vertical"
        android:hint="@string/learned_words_search_hint"
        android:imeOptions="actionDone|flagNoPersonalizedLearning"
        android:importantForAutofill="no"
        android:inputType="text|textNoSuggestions"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="#F4F7FA"
        android:textColorHint="#A8B2BE"/>
  </FrameLayout>

  <HorizontalScrollView
      android:layout_width="match_parent"
      android:layout_height="48dp"
      android:layout_marginBottom="8dp"
      android:fillViewport="false"
      android:scrollbars="none">
    <LinearLayout
        android:id="@+id/learned_words_length_filters"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"/>
  </HorizontalScrollView>

  <TextView
      android:id="@+id/learned_words_message"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:accessibilityLiveRegion="polite"
      android:gravity="center"
      android:minHeight="96dp"
      android:padding="16dp"
      android:text="@string/learned_words_taught_empty"
      android:textSize="16sp"/>

  <ListView
      android:id="@+id/learned_words_list"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:divider="@android:color/transparent"
      android:dividerHeight="8dp"
      android:visibility="gone"/>
</LinearLayout>
