<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reader_transport"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone"
    android:paddingHorizontal="4dp"
    android:paddingVertical="8dp">
  <TextView
      android:id="@+id/reader_transport_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="8dp"
      android:ellipsize="marquee"
      android:marqueeRepeatLimit="marquee_forever"
      android:scrollHorizontally="true"
      android:singleLine="true"
      android:gravity="center"
      android:visibility="gone"
      android:textColor="?attr/colorLabel"/>
  <LinearLayout
      android:id="@+id/reader_transport_playback_controls"
      android:layout_width="match_parent"
      android:layout_height="48dp"
      android:gravity="center"
      android:orientation="horizontal"
      android:visibility="gone">
    <ImageButton
        android:id="@+id/reader_transport_previous"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/reader_icon_button"
        android:contentDescription="@string/reader_previous"
        android:padding="0dp"
        android:scaleType="center"
        android:src="@drawable/ic_reader_previous"
        android:tint="?attr/colorLabel"/>
    <ImageButton
        android:id="@+id/reader_transport_play_pause"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/reader_icon_button"
        android:contentDescription="@string/reader_pause"
        android:padding="0dp"
        android:scaleType="center"
        android:src="@drawable/ic_reader_pause"
        android:tint="?attr/colorLabel"/>
    <ImageButton
        android:id="@+id/reader_transport_next"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/reader_icon_button"
        android:contentDescription="@string/reader_next"
        android:padding="0dp"
        android:scaleType="center"
        android:src="@drawable/ic_reader_next"
        android:tint="?attr/colorLabel"/>
    <ImageButton
        android:id="@+id/reader_transport_stop"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/reader_icon_button"
        android:contentDescription="@string/reader_stop"
        android:padding="0dp"
        android:scaleType="center"
        android:src="@drawable/ic_reader_stop"
        android:tint="?attr/colorLabel"/>
  </LinearLayout>
  <LinearLayout
      android:id="@+id/reader_transport_speed_row"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:orientation="vertical"
      android:visibility="gone">
    <TextView
        android:id="@+id/reader_transport_speed_label"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:gravity="center"
        android:text="@string/reader_speed_default"
        android:textColor="?attr/colorLabel"
        android:textSize="13sp"/>
    <SeekBar
        android:id="@+id/reader_transport_speed"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:contentDescription="@string/reader_speed_control"
        android:max="755"
        android:progress="135"/>
  </LinearLayout>
  <LinearLayout
      android:id="@+id/reader_transport_actions"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center"
      android:orientation="horizontal">
    <Button
        android:id="@+id/reader_transport_clipboard"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:minHeight="0dp"
        android:paddingVertical="4dp"
        android:paddingHorizontal="16dp"
        android:background="@drawable/reader_keyboard_action_button"
        android:textColor="?attr/colorLabel"
        android:text="@string/reader_source_clipboard"/>
    <Button
        android:id="@+id/reader_transport_library"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:minHeight="0dp"
        android:paddingVertical="4dp"
        android:paddingHorizontal="16dp"
        android:background="@drawable/reader_keyboard_action_button"
        android:textColor="?attr/colorLabel"
        android:text="@string/reader_open_library"/>
    <ImageButton
        android:id="@+id/reader_transport_settings"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/reader_keyboard_action_button"
        android:contentDescription="@string/reader_open_settings"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="7dp"
        android:scaleType="centerInside"
        android:src="@drawable/cog_outline"
        android:tint="?attr/colorLabel"/>
  </LinearLayout>
</LinearLayout>
