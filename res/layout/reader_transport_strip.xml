<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reader_transport"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="8dp"
    android:paddingVertical="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:visibility="gone">
  <TextView
      android:id="@+id/reader_transport_title"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:maxLines="1"
      android:ellipsize="end"
      android:textColor="?attr/colorLabel"/>
  <TextView
      android:id="@+id/reader_transport_previous"
      android:text="◀"
      android:contentDescription="@string/reader_previous"
      style="@style/clipboardToolbarLabel"
      android:minWidth="48dp"
      android:minHeight="48dp"
      android:gravity="center"
      android:clickable="true"
      android:focusable="true"/>
  <TextView
      android:id="@+id/reader_transport_play_pause"
      android:text="@string/reader_pause"
      android:contentDescription="@string/reader_pause"
      style="@style/clipboardToolbarLabel"
      android:minWidth="48dp"
      android:minHeight="48dp"
      android:gravity="center"
      android:clickable="true"
      android:focusable="true"/>
  <TextView
      android:id="@+id/reader_transport_next"
      android:text="▶"
      android:contentDescription="@string/reader_next"
      style="@style/clipboardToolbarLabel"
      android:minWidth="48dp"
      android:minHeight="48dp"
      android:gravity="center"
      android:clickable="true"
      android:focusable="true"/>
  <TextView
      android:id="@+id/reader_transport_stop"
      android:text="■"
      android:contentDescription="@string/reader_stop"
      style="@style/clipboardToolbarLabel"
      android:minWidth="48dp"
      android:minHeight="48dp"
      android:gravity="center"
      android:clickable="true"
      android:focusable="true"/>
  <TextView
      android:id="@+id/reader_transport_open"
      android:text="@string/reader_transport_open"
      android:contentDescription="@string/launcher_button_reader"
      style="@style/clipboardToolbarLabel"
      android:minWidth="48dp"
      android:minHeight="48dp"
      android:gravity="center"
      android:paddingHorizontal="6dp"
      android:clickable="true"
      android:focusable="true"/>
</LinearLayout>
