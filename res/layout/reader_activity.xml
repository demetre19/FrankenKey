<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
      <ImageButton
          android:id="@+id/reader_back"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:layout_marginEnd="8dp"
          android:background="@drawable/reader_themed_icon_button"
          android:contentDescription="@string/reader_back"
          android:padding="0dp"
          android:scaleType="center"
          android:src="@drawable/ic_reader_back"
          android:tint="?attr/readerTextColor"/>
      <TextView
          android:id="@+id/reader_document_title"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:gravity="center"
          android:ellipsize="marquee"
          android:marqueeRepeatLimit="marquee_forever"
          android:scrollHorizontally="true"
          android:singleLine="true"
          android:text="@string/reader_activity_title"
          android:textColor="?attr/readerTextColor"
          android:textSize="18sp"
          android:textStyle="bold"/>
      <ImageButton
          android:id="@+id/reader_theme"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:layout_marginStart="8dp"
          android:background="@drawable/reader_themed_icon_button"
          android:contentDescription="@string/reader_use_light_mode"
          android:padding="12dp"
          android:scaleType="center"
          android:src="@drawable/ic_reader_dark_mode"
          android:tint="?attr/readerTextColor"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">
      <Button
          android:id="@+id/reader_open_original"
          android:layout_width="wrap_content"
          android:layout_height="36dp"
          android:background="@drawable/reader_themed_icon_button"
          android:includeFontPadding="false"
          android:minHeight="0dp"
          android:minWidth="0dp"
          android:paddingHorizontal="20dp"
          android:paddingVertical="0dp"
          android:text="@string/reader_open_original"
          android:textColor="?attr/readerTextColor"
          android:visibility="gone"/>
      <Button
          android:id="@+id/reader_clipboard"
          android:layout_width="wrap_content"
          android:layout_height="36dp"
          android:layout_marginStart="8dp"
          android:background="@drawable/reader_themed_icon_button"
          android:includeFontPadding="false"
          android:minHeight="0dp"
          android:minWidth="0dp"
          android:paddingHorizontal="20dp"
          android:paddingVertical="0dp"
          android:text="@string/reader_source_clipboard"
          android:textColor="?attr/readerTextColor"/>
      <Button
          android:id="@+id/reader_library"
          android:layout_width="wrap_content"
          android:layout_height="36dp"
          android:layout_marginStart="8dp"
          android:background="@drawable/reader_themed_icon_button"
          android:includeFontPadding="false"
          android:minHeight="0dp"
          android:minWidth="0dp"
          android:paddingHorizontal="20dp"
          android:paddingVertical="0dp"
          android:text="@string/reader_open_library"
          android:textColor="?attr/readerTextColor"/>
    </LinearLayout>
  </LinearLayout>

  <ScrollView
      android:id="@+id/reader_article_scroll"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:fillViewport="true"
      android:overScrollMode="ifContentScrolls">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

      <TextView
          android:id="@+id/reader_status"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:accessibilityLiveRegion="polite"
          android:gravity="end"
          android:maxLines="2"
          android:text="@string/reader_status_stopped"
          android:textColor="?android:attr/colorAccent"
          android:textSize="13sp"/>

      <LinearLayout
          android:id="@+id/reader_source_metadata"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:visibility="gone">
        <TextView
            android:id="@+id/reader_item_metadata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/readerSecondaryTextColor"
            android:textSize="13sp"/>
      </LinearLayout>

      <LinearLayout
          android:id="@+id/reader_unit_navigation"
          android:layout_width="match_parent"
          android:layout_height="48dp"
          android:layout_marginTop="4dp"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:visibility="gone">
        <Button
            android:id="@+id/reader_unit_previous"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/reader_previous_section"
            android:background="@drawable/reader_themed_icon_button"
            android:textColor="?attr/readerTextColor"
            android:minHeight="48dp"
            android:text="‹"
            android:textSize="24sp"/>
        <TextView
            android:id="@+id/reader_unit_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/reader_unit_plain"
            android:textColor="?attr/readerSecondaryTextColor"
            android:textSize="14sp"/>
        <Button
            android:id="@+id/reader_unit_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/reader_next_section"
            android:background="@drawable/reader_themed_icon_button"
            android:textColor="?attr/readerTextColor"
            android:minHeight="48dp"
            android:text="›"
            android:textSize="24sp"/>
      </LinearLayout>

      <EditText
          android:id="@+id/reader_text"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:background="@android:color/transparent"
          android:gravity="top|start"
          android:hint="@string/reader_text_hint"
          android:inputType="textCapSentences|textMultiLine"
          android:maxLength="200000"
          android:minHeight="320dp"
          android:nestedScrollingEnabled="false"
          android:paddingStart="12dp"
          android:paddingTop="12dp"
          android:paddingEnd="12dp"
          android:paddingBottom="16dp"
          android:scrollbars="none"
          android:textColor="?attr/readerTextColor"
          android:textColorHint="?attr/readerSecondaryTextColor"
          android:textIsSelectable="true"
          android:textSize="18sp"/>

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="16dp"
          android:layout_marginBottom="8dp"
          android:text="@string/reader_reading_settings"
          android:textColor="?attr/readerTextColor"
          android:textSize="16sp"
          android:textStyle="bold"/>

      <LinearLayout
          android:id="@+id/reader_end_settings"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="@drawable/reader_settings_surface"
          android:orientation="vertical"
          android:paddingStart="12dp"
          android:paddingTop="8dp"
          android:paddingEnd="12dp"
          android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
          <TextView
              android:id="@+id/reader_pitch_label"
              android:layout_width="88dp"
              android:layout_height="wrap_content"
              android:text="@string/reader_pitch_default"
              android:textColor="?attr/readerTextColor"
              android:textSize="14sp"/>
          <SeekBar
              android:id="@+id/reader_pitch"
              android:layout_width="0dp"
              android:layout_height="48dp"
              android:layout_weight="1"
              android:contentDescription="@string/reader_pitch_control"
              android:max="150"
              android:progress="50"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
          <TextView
              android:layout_width="88dp"
              android:layout_height="wrap_content"
              android:text="@string/reader_follow_along"
              android:textColor="?attr/readerTextColor"
              android:textSize="14sp"/>
          <Spinner
              android:id="@+id/reader_follow_mode"
              android:layout_width="0dp"
              android:layout_height="48dp"
              android:layout_weight="1"
              android:contentDescription="@string/reader_follow_along"
              android:minHeight="48dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
          <Spinner
              android:id="@+id/reader_voice"
              android:layout_width="0dp"
              android:layout_height="48dp"
              android:layout_weight="1"
              android:contentDescription="@string/reader_voice_select"
              android:minHeight="48dp"/>
          <ImageButton
              android:id="@+id/reader_preview_voice"
              android:layout_width="48dp"
              android:layout_height="48dp"
              android:layout_marginStart="8dp"
              android:background="@drawable/reader_themed_icon_button"
              android:contentDescription="@string/reader_voice_preview"
              android:padding="0dp"
              android:scaleType="center"
              android:src="@drawable/ic_reader_play"
              android:tint="?attr/readerTextColor"/>
        </LinearLayout>

        <Switch
            android:id="@+id/reader_network_voices"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:text="@string/reader_network_voices"/>

        <TextView
            android:id="@+id/reader_network_explanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reader_network_voices_explanation"
            android:textColor="?attr/readerSecondaryTextColor"
            android:textSize="12sp"/>
      </LinearLayout>
    </LinearLayout>
  </ScrollView>

  <LinearLayout
      android:id="@+id/reader_control_dock"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@drawable/reader_settings_surface"
      android:orientation="vertical"
      android:paddingStart="8dp"
      android:paddingTop="8dp"
      android:paddingEnd="8dp"
      android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center"
        android:orientation="horizontal">
      <ImageButton
          android:id="@+id/reader_previous"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:layout_marginStart="4dp"
          android:layout_marginEnd="4dp"
          android:background="@drawable/reader_themed_icon_button"
          android:contentDescription="@string/reader_previous"
          android:padding="0dp"
          android:scaleType="center"
          android:src="@drawable/ic_reader_previous"
          android:tint="?attr/readerTextColor"/>
      <ImageButton
          android:id="@+id/reader_play_pause"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:layout_marginStart="4dp"
          android:layout_marginEnd="4dp"
          android:background="@drawable/reader_themed_icon_button"
          android:contentDescription="@string/reader_play"
          android:padding="0dp"
          android:scaleType="center"
          android:src="@drawable/ic_reader_play"
          android:tint="?android:attr/colorAccent"/>
      <ImageButton
          android:id="@+id/reader_next"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:layout_marginStart="4dp"
          android:layout_marginEnd="4dp"
          android:background="@drawable/reader_themed_icon_button"
          android:contentDescription="@string/reader_next"
          android:padding="0dp"
          android:scaleType="center"
          android:src="@drawable/ic_reader_next"
          android:tint="?attr/readerTextColor"/>
      <ImageButton
          android:id="@+id/reader_stop"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:layout_marginStart="4dp"
          android:layout_marginEnd="4dp"
          android:background="@drawable/reader_themed_icon_button"
          android:contentDescription="@string/reader_stop"
          android:padding="0dp"
          android:scaleType="center"
          android:src="@drawable/ic_reader_stop"
          android:tint="?attr/readerTextColor"/>
      <ImageButton
          android:id="@+id/reader_jump_bottom"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:layout_marginStart="4dp"
          android:layout_marginEnd="4dp"
          android:background="@drawable/reader_themed_icon_button"
          android:contentDescription="@string/reader_jump_to_bottom"
          android:padding="0dp"
          android:scaleType="center"
          android:src="@drawable/ic_reader_bottom"
          android:tint="?attr/readerTextColor"
          android:visibility="gone"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
      <TextView
          android:id="@+id/reader_speed_label"
          android:layout_width="88dp"
          android:layout_height="wrap_content"
          android:gravity="center_vertical"
          android:text="@string/reader_speed_default"
          android:textColor="?attr/readerTextColor"
          android:textSize="14sp"/>
      <SeekBar
          android:id="@+id/reader_speed"
          android:layout_width="0dp"
          android:layout_height="48dp"
          android:layout_weight="1"
          android:contentDescription="@string/reader_speed_control"
          android:max="755"
          android:progress="135"/>
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
