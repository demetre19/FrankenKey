<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0D10"
    android:fillViewport="true"
    android:fitsSystemWindows="true">
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="12dp"
      android:paddingTop="8dp"
      android:paddingEnd="12dp"
      android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
      <ImageButton
          android:id="@+id/reader_back"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:layout_marginEnd="8dp"
          android:background="@drawable/reader_icon_button"
          android:contentDescription="@string/reader_back"
          android:padding="0dp"
          android:scaleType="center"
          android:src="@drawable/ic_reader_back"
          android:tint="#F4F7FA"/>
      <Space
          android:layout_width="0dp"
          android:layout_height="1dp"
          android:layout_weight="1"/>
      <Button
          android:id="@+id/reader_library"
          android:layout_width="wrap_content"
          android:layout_height="48dp"
          android:layout_marginEnd="8dp"
          android:minHeight="48dp"
          android:text="@string/reader_open_library"/>
      <TextView
          android:id="@+id/reader_status"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:accessibilityLiveRegion="polite"
          android:gravity="end"
          android:maxLines="2"
          android:text="@string/reader_status_stopped"
          android:textColor="#8CE9D7"
          android:textSize="14sp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/reader_item_metadata"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#A8B2BE"
        android:textSize="13sp"
        android:visibility="gone"/>

    <EditText
        android:id="@+id/reader_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/launcher_input"
        android:gravity="top|start"
        android:hint="@string/reader_text_hint"
        android:inputType="textCapSentences|textMultiLine"
        android:maxLength="200000"
        android:minHeight="152dp"
        android:padding="12dp"
        android:scrollbars="vertical"
        android:textColor="#F4F7FA"
        android:textColorHint="#A8B2BE"
        android:textSize="17sp"/>

    <LinearLayout
        android:id="@+id/reader_unit_navigation"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
      <Button
          android:id="@+id/reader_unit_previous"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:contentDescription="@string/reader_previous_section"
          android:minHeight="48dp"
          android:text="‹"
          android:textSize="24sp"/>
      <TextView
          android:id="@+id/reader_unit_label"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:gravity="center"
          android:text="@string/reader_unit_plain"
          android:textColor="#D6DCE3"
          android:textSize="14sp"/>
      <Button
          android:id="@+id/reader_unit_next"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:contentDescription="@string/reader_next_section"
          android:minHeight="48dp"
          android:text="›"
          android:textSize="24sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
      <TextView
          android:id="@+id/reader_progress_label"
          android:layout_width="48dp"
          android:layout_height="wrap_content"
          android:gravity="center_vertical"
          android:text="@string/reader_progress_zero"
          android:textColor="#D6DCE3"
          android:textSize="13sp"/>
      <SeekBar
          android:id="@+id/reader_progress"
          android:layout_width="0dp"
          android:layout_height="48dp"
          android:layout_weight="1"
          android:contentDescription="@string/reader_progress_seek"
          android:max="1000"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center"
        android:orientation="horizontal">
      <ImageButton
          android:id="@+id/reader_previous"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:layout_marginStart="4dp"
          android:layout_marginEnd="4dp"
          android:background="@drawable/reader_icon_button"
          android:contentDescription="@string/reader_previous"
          android:padding="0dp"
          android:scaleType="center"
          android:src="@drawable/ic_reader_previous"
          android:tint="#F4F7FA"/>
      <ImageButton
          android:id="@+id/reader_play_pause"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:layout_marginStart="4dp"
          android:layout_marginEnd="4dp"
          android:background="@drawable/reader_icon_button"
          android:contentDescription="@string/reader_play"
          android:padding="0dp"
          android:scaleType="center"
          android:src="@drawable/ic_reader_play"
          android:tint="#8CE9D7"/>
      <ImageButton
          android:id="@+id/reader_next"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:layout_marginStart="4dp"
          android:layout_marginEnd="4dp"
          android:background="@drawable/reader_icon_button"
          android:contentDescription="@string/reader_next"
          android:padding="0dp"
          android:scaleType="center"
          android:src="@drawable/ic_reader_next"
          android:tint="#F4F7FA"/>
      <ImageButton
          android:id="@+id/reader_stop"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:layout_marginStart="4dp"
          android:layout_marginEnd="4dp"
          android:background="@drawable/reader_icon_button"
          android:contentDescription="@string/reader_stop"
          android:padding="0dp"
          android:scaleType="center"
          android:src="@drawable/ic_reader_stop"
          android:tint="#F4F7FA"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
      <Spinner
          android:id="@+id/reader_voice"
          android:layout_width="0dp"
          android:layout_height="48dp"
          android:layout_weight="1"
          android:contentDescription="@string/reader_voice_select"
          android:minHeight="48dp"/>
      <ImageButton
          android:id="@+id/reader_preview_voice"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:layout_marginStart="8dp"
          android:background="@drawable/reader_icon_button"
          android:contentDescription="@string/reader_voice_preview"
          android:padding="0dp"
          android:scaleType="center"
          android:src="@drawable/ic_reader_play"
          android:tint="#F4F7FA"/>
    </LinearLayout>

    <Switch
        android:id="@+id/reader_network_voices"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:minHeight="48dp"
        android:text="@string/reader_network_voices"/>

    <TextView
        android:id="@+id/reader_network_explanation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/reader_network_voices_explanation"
        android:textColor="#A8B2BE"
        android:textSize="12sp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
      <TextView
          android:id="@+id/reader_speed_label"
          android:layout_width="88dp"
          android:layout_height="wrap_content"
          android:gravity="center_vertical"
          android:text="@string/reader_speed_default"
          android:textColor="#F4F7FA"
          android:textSize="14sp"/>
      <SeekBar
          android:id="@+id/reader_speed"
          android:layout_width="0dp"
          android:layout_height="48dp"
          android:layout_weight="1"
          android:contentDescription="@string/reader_speed_control"
          android:max="275"
          android:progress="75"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
      <TextView
          android:id="@+id/reader_pitch_label"
          android:layout_width="88dp"
          android:layout_height="wrap_content"
          android:gravity="center_vertical"
          android:text="@string/reader_pitch_default"
          android:textColor="#F4F7FA"
          android:textSize="14sp"/>
      <SeekBar
          android:id="@+id/reader_pitch"
          android:layout_width="0dp"
          android:layout_height="48dp"
          android:layout_weight="1"
          android:contentDescription="@string/reader_pitch_control"
          android:max="150"
          android:progress="50"/>
    </LinearLayout>
  </LinearLayout>
</ScrollView>
