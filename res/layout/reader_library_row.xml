<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/launcher_input"
    android:orientation="vertical"
    android:padding="12dp">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="top"
      android:orientation="horizontal">
    <ImageView
        android:id="@+id/reader_library_row_image"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone"/>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
      <TextView
          android:id="@+id/reader_library_row_title"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:maxLines="2"
          android:textColor="#F4F7FA"
          android:textSize="17sp"
          android:textStyle="bold"/>
      <TextView
          android:id="@+id/reader_library_row_metadata"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:textColor="#A8B2BE"
          android:textSize="13sp"/>
      <TextView
          android:id="@+id/reader_library_row_progress"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:textColor="#8CE9D7"
          android:textSize="13sp"/>
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="36dp"
      android:layout_marginTop="8dp"
      android:gravity="end|center_vertical"
      android:orientation="horizontal">
    <Button
        android:id="@+id/reader_library_row_original"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/reader_themed_icon_button"
        android:includeFontPadding="false"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="0dp"
        android:text="@string/reader_open_original"
        android:textColor="?attr/readerTextColor"
        android:visibility="gone"/>
    <Button
        android:id="@+id/reader_library_row_delete"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/reader_themed_icon_button"
        android:includeFontPadding="false"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="0dp"
        android:text="@string/reader_library_delete"
        android:textColor="?attr/readerTextColor"/>
    <Button
        android:id="@+id/reader_library_row_open"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@drawable/reader_themed_icon_button"
        android:includeFontPadding="false"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="0dp"
        android:text="@string/reader_library_open"
        android:textColor="?attr/readerTextColor"/>
  </LinearLayout>
</LinearLayout>
