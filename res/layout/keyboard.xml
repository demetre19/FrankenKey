<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:hardwareAccelerated="false" android:orientation="vertical" android:background="?attr/colorKeyboard">
  <juloo.keyboard2.suggestions.CandidatesView android:id="@+id/candidates_view" style="@style/candidates_view">
    <TextView android:id="@+id/candidates_emoji" style="@style/candidates_emoji"/>
    <TextView android:id="@+id/candidates_left" style="@style/candidates_item"/>
    <TextView android:id="@+id/candidates_separator_left" style="@style/candidates_separator"/>
    <TextView android:id="@+id/candidates_middle" style="@style/candidates_item"/>
    <TextView android:id="@+id/candidates_separator_right" style="@style/candidates_separator"/>
    <TextView android:id="@+id/candidates_right" style="@style/candidates_item"/>
    <TextView android:id="@+id/keyboard_reader" android:text="@string/reader_source_button" android:contentDescription="@string/reader_source_menu_title" android:layout_width="48dp" android:layout_height="match_parent" android:minHeight="48dp" android:gravity="center" android:textColor="?attr/colorLabel" android:clickable="true" android:focusable="true"/>
  </juloo.keyboard2.suggestions.CandidatesView>
  <include layout="@layout/assistant_strip"/>
  <include layout="@layout/reader_transport_strip"/>
  <juloo.keyboard2.snippets.SnippetRowView android:id="@+id/snippet_row" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <juloo.keyboard2.Keyboard2View android:id="@+id/keyboard_view" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
