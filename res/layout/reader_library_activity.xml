<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0D10"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="48dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">
    <ImageButton
        android:id="@+id/reader_library_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/reader_icon_button"
        android:contentDescription="@string/reader_back"
        android:padding="0dp"
        android:scaleType="center"
        android:src="@drawable/ic_reader_back"
        android:tint="#F4F7FA"/>
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:text="@string/reader_library_title"
        android:textColor="#F4F7FA"
        android:textSize="20sp"
        android:textStyle="bold"/>
  </LinearLayout>

  <EditText
      android:id="@+id/reader_library_search"
      android:layout_width="match_parent"
      android:layout_height="48dp"
      android:layout_marginTop="8dp"
      android:layout_marginBottom="8dp"
      android:background="@drawable/launcher_input"
      android:hint="@string/reader_library_search_hint"
      android:importantForAutofill="no"
      android:inputType="text"
      android:maxLines="1"
      android:paddingStart="12dp"
      android:paddingEnd="12dp"
      android:singleLine="true"
      android:textColor="#F4F7FA"
      android:textColorHint="#A8B2BE"/>

  <TextView
      android:id="@+id/reader_library_message"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:accessibilityLiveRegion="polite"
      android:gravity="center"
      android:minHeight="96dp"
      android:padding="16dp"
      android:text="@string/reader_library_empty"
      android:textColor="#A8B2BE"
      android:textSize="16sp"/>

  <ListView
      android:id="@+id/reader_library_list"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:divider="@android:color/transparent"
      android:dividerHeight="8dp"
      android:visibility="gone"/>
</LinearLayout>
