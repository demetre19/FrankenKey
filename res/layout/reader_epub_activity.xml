<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reader_epub_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

  <LinearLayout
      android:id="@+id/reader_epub_header"
      android:layout_width="match_parent"
      android:layout_height="60dp"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="8dp"
      android:paddingEnd="12dp">
    <ImageButton
        android:id="@+id/reader_epub_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/reader_back"
        android:padding="0dp"
        android:scaleType="center"
        android:src="@drawable/ic_reader_back"/>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">
      <TextView
          android:id="@+id/reader_epub_title"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:maxLines="1"
          android:textColor="#f8fafc"
          android:textSize="16sp"
          android:textStyle="bold"/>
      <TextView
          android:id="@+id/reader_epub_author"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:maxLines="1"
          android:textColor="#94a3b8"
          android:textSize="12sp"/>
    </LinearLayout>
    <TextView
        android:id="@+id/reader_epub_percent"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:text="0%"
        android:textColor="#55D6BE"
        android:textSize="13sp"
        android:textStyle="bold"/>
  </LinearLayout>

  <ProgressBar
      android:id="@+id/reader_epub_progress"
      style="?android:attr/progressBarStyleHorizontal"
      android:layout_width="match_parent"
      android:layout_height="2dp"
      android:max="10000"
      android:progress="0"
      android:progressBackgroundTint="#263238"
      android:progressTint="#55D6BE"/>

  <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1">
    <WebView
        android:id="@+id/reader_epub_webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:contentDescription="@string/reader_epub_content_accessibility"/>
    <ProgressBar
        android:id="@+id/reader_epub_loading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="#55D6BE"/>
    <TextView
        android:id="@+id/reader_epub_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="24dp"
        android:textColor="#f8fafc"
        android:textSize="15sp"
        android:visibility="gone"/>
  </FrameLayout>

  <LinearLayout
      android:id="@+id/reader_epub_toolbar"
      android:layout_width="match_parent"
      android:layout_height="52dp"
      android:gravity="center"
      android:orientation="horizontal"
      android:paddingStart="4dp"
      android:paddingEnd="4dp"
      android:paddingBottom="4dp">
    <TextView
        android:id="@+id/reader_epub_smaller"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/reader_epub_smaller_accessibility"
        android:gravity="center"
        android:includeFontPadding="false"
        android:minHeight="48dp"
        android:minWidth="48dp"
        android:text="A-"
        android:textColor="#FFFFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"/>
    <TextView
        android:id="@+id/reader_epub_larger"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/reader_epub_larger_accessibility"
        android:gravity="center"
        android:includeFontPadding="false"
        android:minHeight="48dp"
        android:minWidth="48dp"
        android:text="A+"
        android:textColor="#FFFFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"/>
    <TextView
        android:id="@+id/reader_epub_font"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/reader_epub_font_accessibility"
        android:gravity="center"
        android:includeFontPadding="false"
        android:minHeight="48dp"
        android:minWidth="48dp"
        android:text="Aa"
        android:textColor="#FFFFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"/>
    <ImageButton
        android:id="@+id/reader_epub_images"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/reader_epub_images_accessibility"
        android:minHeight="48dp"
        android:minWidth="48dp"
        android:padding="15dp"
        android:scaleType="center"
        android:src="@drawable/ic_reader_images"/>
    <ImageButton
        android:id="@+id/reader_epub_theme"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/reader_epub_theme_accessibility"
        android:minHeight="48dp"
        android:minWidth="48dp"
        android:padding="15dp"
        android:scaleType="center"
        android:src="@drawable/ic_reader_theme"/>
    <TextView
        android:id="@+id/reader_epub_ai"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/reader_epub_ai_accessibility"
        android:gravity="center"
        android:includeFontPadding="false"
        android:minHeight="48dp"
        android:minWidth="48dp"
        android:text="AI"
        android:textColor="#FFFFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"/>
    <TextView
        android:id="@+id/reader_epub_open_3d"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/reader_open_3d_accessibility"
        android:gravity="center"
        android:includeFontPadding="false"
        android:minHeight="48dp"
        android:minWidth="48dp"
        android:text="3D"
        android:textColor="#FFFFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"/>
  </LinearLayout>
</LinearLayout>
