<?xml version="1.0" encoding="utf-8"?>
<juloo.keyboard2.grammar.GrammarDiffView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/grammar_diff_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorKeyboard"
    android:paddingHorizontal="8dp"
    android:paddingVertical="8dp"
    android:visibility="gone">
  <TextView
      android:id="@+id/grammar_diff_header"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="8dp"
      android:text="@string/grammar_diff_private_header"
      android:textColor="?attr/colorLabel"
      android:textSize="13sp"
      android:visibility="gone"/>
  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="8dp">
    <TextView
        android:id="@+id/grammar_diff_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorLabel"
        android:textSize="15sp"/>
  </ScrollView>
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center"
      android:orientation="horizontal">
    <Button
        android:id="@+id/grammar_diff_replace"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:minHeight="36dp"
        android:paddingVertical="4dp"
        android:paddingHorizontal="16dp"
        android:background="@drawable/reader_keyboard_action_button"
        android:textColor="?attr/colorLabel"
        android:text="@string/grammar_diff_replace"/>
    <Button
        android:id="@+id/grammar_diff_copy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:minHeight="36dp"
        android:paddingVertical="4dp"
        android:paddingHorizontal="16dp"
        android:background="@drawable/reader_keyboard_action_button"
        android:textColor="?attr/colorLabel"
        android:text="@string/grammar_diff_copy"/>
    <Button
        android:id="@+id/grammar_diff_cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="36dp"
        android:paddingVertical="4dp"
        android:paddingHorizontal="16dp"
        android:background="@drawable/reader_keyboard_action_button"
        android:textColor="?attr/colorLabel"
        android:text="@string/grammar_diff_cancel"/>
  </LinearLayout>
</juloo.keyboard2.grammar.GrammarDiffView>
