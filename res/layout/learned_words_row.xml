<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@drawable/launcher_input"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingEnd="4dp">

  <LinearLayout
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:gravity="center_vertical"
      android:orientation="vertical"
      android:paddingStart="12dp"
      android:paddingEnd="8dp">
    <TextView
        android:id="@+id/learned_words_row_word"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#F4F7FA"
        android:textSize="15sp"
        android:textStyle="bold"/>
    <TextView
        android:id="@+id/learned_words_row_mapping"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#A8B2BE"
        android:textSize="13sp"/>
  </LinearLayout>

  <Button
      android:id="@+id/learned_words_row_edit"
      android:layout_width="wrap_content"
      android:layout_height="48dp"
      android:background="@drawable/reader_icon_button"
      android:minWidth="64dp"
      android:text="@string/learned_words_edit_action"
      android:textColor="#F4F7FA"/>

  <Button
      android:id="@+id/learned_words_row_forget"
      android:layout_width="wrap_content"
      android:layout_height="48dp"
      android:layout_marginStart="8dp"
      android:background="@drawable/reader_icon_button"
      android:minWidth="80dp"
      android:text="@string/learned_words_forget_action"
      android:textColor="#F4F7FA"/>
</LinearLayout>
