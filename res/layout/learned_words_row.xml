<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@drawable/launcher_input"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="4dp">

  <TextView
      android:id="@+id/learned_words_row_word"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#F4F7FA"
      android:textSize="15sp"
      android:textStyle="bold"/>

  <Button
      android:id="@+id/learned_words_row_forget"
      android:layout_width="wrap_content"
      android:layout_height="48dp"
      android:background="@drawable/reader_icon_button"
      android:minWidth="80dp"
      android:text="@string/learned_words_forget_action"
      android:textColor="#F4F7FA"/>
</LinearLayout>
